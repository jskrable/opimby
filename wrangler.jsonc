{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opimby",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opimby",
      // TODO: replace with the id from `bunx wrangler d1 create opimby`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // TODO: set from the Cloudflare Access app guarding /admin. Until then /admin returns 403.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": {
    // Off so volunteers' personal info never lands in request logs.
    "enabled": false
  }
}
