{
  "name": "opimby",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local astro dev",
    "build": "astro build",
    "preview": "CLOUDFLARE_ENV=local astro build && CLOUDFLARE_ENV=local astro preview",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "types": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply opimby --local",
    "db:migrate:remote": "wrangler d1 migrations apply opimby --remote",
    "infra": "terraform -chdir=infra",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "astro": "^7.3.6",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "http-cache-semantics": "^4.3.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  }
}
