---
interface Props {
  form: string;
  title: string;
}

const { form, title } = Astro.props;
---

<div data-zeffy-embed data-form-url={`/embed/${form}`} data-title={title}></div>
<noscript>
  <ul class="link-list actions">
    <li><a href={`https://www.zeffy.com/en-US/${form}`}>Open the donation form on Zeffy</a></li>
  </ul>
</noscript>
<script is:inline src="https://www.zeffy.com/embed/v2/zeffy-embed.js" async></script>
<script>
  // zeffy-embed.js creates the iframe without a title.
  // It may run before or after this script, so check now and on change.
  for (const embed of document.querySelectorAll<HTMLElement>("[data-zeffy-embed]")) {
    const setTitle = () => {
      const frame = embed.querySelector("iframe");
      if (frame) frame.title = embed.dataset.title ?? "";
      return Boolean(frame);
    };
    if (setTitle()) continue;
    new MutationObserver((_, observer) => {
      if (setTitle()) observer.disconnect();
    }).observe(embed, { childList: true, subtree: true });
  }
</script>
