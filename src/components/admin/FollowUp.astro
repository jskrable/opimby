---
import { NOTE_MAX, NOTE_MESSAGES } from "../../forms/notes";
import type { Note } from "../../server/followup/types";
import type { Responded } from "../../server/shared/types";
import Field from "../form/Field.astro";
import type { FollowUpState } from "./follow-up";
import { formatSubmitted } from "./format";

interface Props {
  responded: Responded;
  notes: Note[];
  state: FollowUpState;
}

const { responded, notes, state } = Astro.props;
const admin = Astro.locals.adminEmail;
---

<section id="responded" aria-labelledby="responded-heading">
  <h2 id="responded-heading">Response</h2>
  {
    responded.respondedAt ? (
      <form method="post" class="inline-form">
        <p>Responded by {responded.respondedBy} on {formatSubmitted(responded.respondedAt)}</p>
        <input type="hidden" name="intent" value="unrespond" />
        <button type="submit" class="secondary">Undo</button>
      </form>
    ) : (
      <form method="post" class="inline-form">
        <p>Not responded yet</p>
        <input type="hidden" name="intent" value="respond" />
        <button type="submit">Mark as responded</button>
      </form>
    )
  }
</section>

<section id="notes" aria-labelledby="notes-heading">
  <h2 id="notes-heading">Notes</h2>
  {
    notes.length ? (
      <ul class="notes">
        {notes.map((n) => (
          <li>
            <p class="note-meta">{n.author} · {formatSubmitted(n.createdAt)}</p>
            <p class="prose">{n.body}</p>
            {n.author === admin && (
              <form method="post" class="inline-form">
                <input type="hidden" name="intent" value="delete-note" />
                <input type="hidden" name="noteId" value={n.id} />
                <button type="submit" class="secondary">
                  Delete<span class="visually-hidden"> your note from {formatSubmitted(n.createdAt)}</span>
                </button>
              </form>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p>No notes yet.</p>
    )
  }

  <form method="post" novalidate>
    <input type="hidden" name="intent" value="add-note" />
    <Field name="body" label="Add a note" type="textarea" rows={4} maxlength={NOTE_MAX.body} required requiredMessage={NOTE_MESSAGES.body} value={state.value} error={state.error} />
    <p><button type="submit">Save note</button></p>
  </form>
</section>
