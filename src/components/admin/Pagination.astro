---
interface Props {
  page: number;
  totalPages: number;
  total: number;
  params?: Record<string, string>;
}

const { page, totalPages, total, params = {} } = Astro.props;
const href = (n: number) => `?${new URLSearchParams(n === 1 ? params : { ...params, page: String(n) })}`;
---

<nav class="pagination" aria-label="Pages">
  <p>Page {page} of {totalPages} ({total} total)</p>
  <ul class="link-list">
    {page > 1 && <li><a href={href(page - 1)} rel="prev">Previous page</a></li>}
    {page < totalPages && <li><a href={href(page + 1)} rel="next">Next page</a></li>}
  </ul>
</nav>
