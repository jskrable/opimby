---
import type { Responded } from "../../server/shared/types";
import { formatSubmitted } from "./format";

interface Props {
  responded: Responded;
}

const { respondedAt, respondedBy } = Astro.props.responded;
---

<section id="response" aria-labelledby="response-heading">
  <h2 id="response-heading">Response</h2>
  <form method="post" class="status-row">
    {
      respondedAt ? (
        <>
          <p>Responded <span class="secondary-text status-detail">by {respondedBy} · <span class="nowrap">{formatSubmitted(respondedAt)}</span></span></p>
          <input type="hidden" name="intent" value="unrespond" />
          <button type="submit" class="text-button">Undo</button>
        </>
      ) : (
        <>
          <p>Not responded yet</p>
          <input type="hidden" name="intent" value="respond" />
          <button type="submit" class="text-button">Mark as responded</button>
        </>
      )
    }
  </form>
</section>
