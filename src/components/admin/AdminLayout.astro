---
import Base, { type NavItem } from "../../layouts/Base.astro";

interface Props {
  title: string;
}

const ADMIN_NAV: NavItem[] = [
  { href: "/admin/", label: "Overview" },
  { href: "/admin/volunteers/", label: "Volunteers" },
  { href: "/admin/donations/", label: "Item donations" },
];
---

<Base title={`${Astro.props.title} | Admin`} nav={ADMIN_NAV} footer={false} noindex>
  <slot />
</Base>
