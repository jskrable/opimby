---
import ZeffyLink from "../../../components/ZeffyLink.astro";
import Base from "../../../layouts/Base.astro";
import { fundraising } from "../../../server/container";
import { site } from "../../../site";

export const prerender = false;

const { day, time, place } = site.outreach;
const progress = await fundraising.progress(site.zeffy.sponsorCampaignId);
const dollars = (n: number) => `$${n.toLocaleString("en-US")}`;
---

<Base title="Sponsor an outreach" description="Sponsor a January outreach in Kensington, Philadelphia. $1,250 covers one night.">
  <h1>Sponsor an outreach</h1>
  <p>Around the holidays, a lot of people come out to help. In January most of them have gone home, and it's the coldest month of the year.</p>
  <p>We'll be out every {day} at {time} at {place} in Kensington, handing out hot meals, cold weather kits, hygiene items, wound care, safer consumption kits, safer sex supplies and more to about 100 people.</p>
  <p>One outreach costs $1,250. We're raising $6,250 to cover all four in January, with the rest going to extra cold weather kits. Every gift goes into one pool, whatever the size.</p>
  <p>You can give in honor or in memory of someone. {site.name} is a 501(c)(3), so your gift is tax-deductible.</p>

  {progress && (
    <div class="campaign-progress">
      <p id="raised"><strong>{dollars(progress.raised)}</strong> raised of {dollars(progress.goal)}</p>
      <progress aria-labelledby="raised" value={Math.min(progress.raised, progress.goal)} max={progress.goal}></progress>
    </div>
  )}

  <ul class="link-list actions">
    <ZeffyLink href={site.zeffy.sponsor} label="Sponsor an outreach on Zeffy" />
    <li><a href="/donate/">Other ways to donate</a></li>
  </ul>
</Base>
