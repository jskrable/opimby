---
import Base from "../../layouts/Base.astro";
import { site } from "../../site";
---

<Base title="Donate">
  <h1>Donate</h1>
  <p>Your donation pays for hot meals, clothing, hygiene items, naloxone, test strips, safer consumption kits, and more. Sterile supplies mean less disease and fewer overdose deaths. Operation In My Backyard is a 501(c)(3), so your gift is tax-deductible.</p>

  <h2>Funds</h2>
  {site.zeffy.embedUrl ? (
    <iframe title="Donation form" src={site.zeffy.embedUrl} width="100%" height="1200" loading="lazy" allow="payment"></iframe>
  ) : null}
  <ul class="link-list">
    <li><a href={site.links.venmo}>Venmo (@OpImby)</a></li>
    <li><a href={site.links.paypal}>PayPal Giving Fund</a></li>
  </ul>

  <h2>Items</h2>
  <p>We take clothes, blankets, food and drinks, desserts, books, and whatever else helps folks get through life on the street. Bring it by outreach any Tuesday at 6pm at Ruth and Somerset.</p>
  <ul class="link-list">
    <li><a href="/donate/items/">Tell us what you're bringing or ask for a pickup</a></li>
    <li><a href={site.links.amazonWishlist}>Amazon Wish List</a></li>
  </ul>
</Base>
