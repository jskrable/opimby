---
import Base from "../../layouts/Base.astro";
import { site } from "../../site";
---

<Base title="Donate" description="Donate money or items to Operation In My Backyard. Your gift pays for hot meals, cold weather gear, naloxone, test strips, and safer consumption kits in Kensington.">
  <h1>Donate</h1>
  <p>Your donation pays for hot meals, new socks and cold weather gear, hygiene items, naloxone, test strips, safer consumption kits, and more. Sterile supplies mean less disease and fewer overdose deaths. Operation In My Backyard is a 501(c)(3), so your gift is tax-deductible.</p>

  <h2>Funds</h2>
  <div data-zeffy-embed data-form-url={site.zeffyEmbedPath}></div>
  <script is:inline src="https://www.zeffy.com/embed/v2/zeffy-embed.js" async></script>
  <script>
    // zeffy-embed.js creates the iframe without a title.
    new MutationObserver((_, observer) => {
      const frame = document.querySelector<HTMLIFrameElement>("[data-zeffy-embed] iframe");
      if (!frame) return;
      frame.title = "Donation form";
      observer.disconnect();
    }).observe(document.querySelector("[data-zeffy-embed]")!, { childList: true });
  </script>
  <ul class="link-list">
    <li><a href={site.links.zeffy}>Zeffy</a></li>
    <li><a href={site.links.venmo}>Venmo (@OpImby)</a></li>
    <li><a href={site.links.paypal}>PayPal Giving Fund</a></li>
  </ul>

  <h2>Items</h2>
  <p>We take coats, shoes, blankets, food and drinks, snacks, desserts, books, and whatever else helps folks get through life on the street. Bring it by outreach any Tuesday at 6pm at Ruth and Somerset or arrange a pickup by clicking the link below.</p>
  <ul class="link-list">
    <li><a href="/donate/items/">Tell us what you're bringing or ask for a pickup</a></li>
    <li><a href={site.links.amazonWishlist}>Amazon Wish List</a></li>
  </ul>
</Base>
