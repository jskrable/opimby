---
import { DONATION_METHOD_LABELS } from "../forms/donation";
import { displayPhone } from "../forms/phone";
import { VOLUNTEER_INTEREST_LABELS } from "../forms/volunteer";
import { donations, volunteers } from "../server/container";
import { isAdmin } from "../server/shared/access";

export const prerender = false;

if (!(await isAdmin(Astro.request))) {
  return new Response("Forbidden", { status: 403 });
}

Astro.response.headers.set("Cache-Control", "no-store");

const [applications, submissions] = await Promise.all([volunteers.listRecent(), donations.listRecent()]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Submissions | Admin</title>
    <style>.scroll { overflow-x: auto; }</style>
  </head>
  <body>
    <main>
      <h1>Submissions</h1>

      <h2 id="volunteers-title">Volunteer signups</h2>
      <p>{applications.length} most recent</p>
      <div class="scroll" role="region" aria-labelledby="volunteers-title" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">Submitted</th><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Phone</th><th scope="col">Interests</th><th scope="col">Message</th></tr>
        </thead>
        <tbody>
          {applications.map((a) => (
            <tr>
              <td>{a.createdAt} UTC</td>
              <td>{a.name}</td>
              <td><a href={`mailto:${a.email}`}>{a.email}</a></td>
              <td>{a.phone && <a href={`tel:${a.phone}`}>{displayPhone(a.phone)}</a>}</td>
              <td>{a.interests.map((i) => VOLUNTEER_INTEREST_LABELS[i] ?? i).join(", ")}</td>
              <td>{a.message}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>

      <h2 id="donations-title">Item donations</h2>
      <p>{submissions.length} most recent</p>
      <div class="scroll" role="region" aria-labelledby="donations-title" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">Submitted</th><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Phone</th><th scope="col">Items</th><th scope="col">Getting it to us</th><th scope="col">Pickup area</th></tr>
        </thead>
        <tbody>
          {submissions.map((d) => (
            <tr>
              <td>{d.createdAt} UTC</td>
              <td>{d.name}</td>
              <td><a href={`mailto:${d.email}`}>{d.email}</a></td>
              <td>{d.phone && <a href={`tel:${d.phone}`}>{displayPhone(d.phone)}</a>}</td>
              <td>{d.items}</td>
              <td>{DONATION_METHOD_LABELS[d.method] ?? d.method}</td>
              <td>{d.area}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </main>
  </body>
</html>
