---
import Base from "../layouts/Base.astro";
import { site } from "../site";

const home = new URL("/", Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NGO",
      "@id": `${home}#org`,
      name: site.name,
      alternateName: site.shortName,
      url: home,
      logo: new URL("/icon-512.png", Astro.site).href,
      email: site.email,
      taxID: site.ein,
      nonprofitStatus: "Nonprofit501c3",
      foundingDate: "2018",
      areaServed: { "@type": "Place", name: "Kensington, Philadelphia, PA" },
      sameAs: [site.links.instagram, site.links.tiktok, site.links.facebook],
    },
  ],
};
---

<Base>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <h1>{site.name}</h1>
  <p>A harm reduction outreach group in Kensington, Philadelphia, looking out for people experiencing homelessness and people who use drugs since 2018.</p>

  <h2>What we do</h2>
  <p>Every {site.outreach.day} at {site.outreach.time} we set up at the corner of {site.outreach.place}. We hand out hot meals, new socks, coats and cold weather gear, hygiene items, naloxone, test strips (fentanyl, medetomidine, xylazine, benzos), safer consumption kits, safer sex supplies, and more.</p>

  <ul class="link-list actions">
    <li><a href="/donate/">Donate</a></li>
    <li><a href="/volunteer/">Volunteer</a></li>
  </ul>
</Base>
