---
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../site";

const photos = (await getCollection("photos")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Photos">
  <h1>Photos</h1>
  <p>Some photos of our volunteers in action,</p>
  {photos.map(({ data }, i) => (
    <figure class="photo">
      <Picture
        src={data.image}
        alt={data.alt}
        formats={["avif", "webp"]}
        layout="constrained"
        width={640}
        loading={i === 0 ? "eager" : "lazy"}
      />
      {data.caption && <figcaption>{data.caption}</figcaption>}
    </figure>
  ))}
  <p class="standalone"><a href={site.links.instagram}>See more and keep up with our weekly outreach videos on Instagram</a></p>
</Base>
