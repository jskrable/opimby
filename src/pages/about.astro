import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title="About" description="Operation In My Backyard is a 501(c)(3) in Kensington, Philadelphia.">
  <h1>About</h1>
  <p>We show up every week for people experiencing homelessness and people who use drugs in Kensington. We bring what people ask for, we learn names, and we keep coming back.</p>
  <p>When someone wants treatment or other help, we know them well enough to help them find something that works for them, whatever that looks like.</p>
  <p>We're a 501(c)(3) nonprofit.</p>
  <p>We post from outreach every week on <a href={site.links.instagram}>Instagram</a> and <a href={site.links.facebook}>Facebook</a>. That's the best way to see what we do.</p>
</Base>
