---
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import Contact from "../../../components/admin/Contact.astro";
import { handleFollowUp } from "../../../components/admin/follow-up";
import { formatSubmitted } from "../../../components/admin/format";
import Notes from "../../../components/admin/Notes.astro";
import ResponseStatus from "../../../components/admin/ResponseStatus.astro";
import { VOLUNTEER_INTEREST_LABELS } from "../../../forms/volunteer";
import { followUp, volunteers } from "../../../server/container";

export const prerender = false;

const application = await volunteers.get(Number(Astro.params.id));
if (!application) Astro.response.status = 404;

const state = application ? await handleFollowUp(Astro, "volunteer", application.id) : {};
if (state instanceof Response) return state;
const notes = application ? await followUp.notes("volunteer", application.id) : [];
const heading = application ? `Volunteer signup #${application.id}` : "Not found";
---

<AdminLayout title={state.error ? `Error: ${heading}` : heading}>
  <p class="standalone"><a href="/admin/volunteers/">All volunteer signups</a></p>
  {
    !application ? (
      <>
        <h1>Not found</h1>
        <p>There's no signup with that number. It may have been deleted.</p>
      </>
    ) : (
      <>
        <h1>{heading}</h1>
        <dl class="details">
          <dt>Name</dt>
          <dd>{application.name}</dd>
          <dt>Submitted</dt>
          <dd>{formatSubmitted(application.createdAt)}</dd>
          <ResponseStatus responded={application} />
          <Contact email={application.email} phone={application.phone} />
          <dt>Wants to help with</dt>
          <dd>
            {application.interests.length ? (
              <ul>{application.interests.map((i) => <li>{VOLUNTEER_INTEREST_LABELS[i] ?? i}</li>)}</ul>
            ) : (
              "Nothing picked"
            )}
          </dd>
          <dt>Message</dt>
          <dd class="prose">{application.message ?? "None"}</dd>
        </dl>
        <Notes notes={notes} state={state} />
      </>
    )
  }
</AdminLayout>
