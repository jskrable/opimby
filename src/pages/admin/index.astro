---
import AdminLayout from "../../components/admin/AdminLayout.astro";
import { donations, volunteers } from "../../server/container";

export const prerender = false;

const [volunteerCount, volunteersOpen, donationCount, donationsOpen] = await Promise.all([
  volunteers.count(),
  volunteers.countOpen(),
  donations.count(),
  donations.countOpen(),
]);
---

<AdminLayout title="Overview">
  <h1>Submissions</h1>
  <ul class="link-list">
    <li><a href="/admin/volunteers/">Volunteer signups ({volunteerCount})</a> <span class="secondary-text">{volunteersOpen} need a response</span></li>
    <li><a href="/admin/donations/">Item donations ({donationCount})</a> <span class="secondary-text">{donationsOpen} need a response</span></li>
  </ul>
</AdminLayout>
