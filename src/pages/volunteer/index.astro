---
import Base from "../../layouts/Base.astro";
import { site } from "../../site";
import { FIELD_MAX, HONEYPOT, VOLUNTEER_INTERESTS } from "../../../shared/volunteer";
---

<Base title="Volunteer">
  <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <h1>Volunteer</h1>
  <p>[PLACEHOLDER: volunteer intro]</p>

  <h2>What we need help with</h2>
  <ul>
    {VOLUNTEER_INTERESTS.map((i) => <li>{i.label}</li>)}
  </ul>

  <p id="form-error" role="alert" hidden></p>

  <form method="post" action="/api/volunteer">
    <p>
      <label for="name">Name</label><br />
      <input id="name" name="name" type="text" autocomplete="name" maxlength={FIELD_MAX.name} required />
    </p>
    <p>
      <label for="email">Email</label><br />
      <input id="email" name="email" type="email" autocomplete="email" maxlength={FIELD_MAX.email} required />
    </p>
    <p>
      <label for="phone">Phone (optional)</label><br />
      <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength={FIELD_MAX.phone} />
    </p>

    <fieldset>
      <legend>How would you like to help?</legend>
      {VOLUNTEER_INTERESTS.map((i) => (
        <p>
          <input id={`interest-${i.value}`} name="interests" type="checkbox" value={i.value} />
          <label for={`interest-${i.value}`}>{i.label}</label>
        </p>
      ))}
    </fieldset>

    <p>
      <label for="message">Message (optional)</label><br />
      <textarea id="message" name="message" rows="5" maxlength={FIELD_MAX.message}></textarea>
    </p>

    <p hidden aria-hidden="true">
      <label for={HONEYPOT}>Leave this empty</label>
      <input id={HONEYPOT} name={HONEYPOT} type="text" tabindex="-1" autocomplete="off" />
    </p>

    <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-theme="dark"></div>

    <p><button type="submit">Sign up</button></p>
  </form>

  <script is:inline>
    const messages = {
      verify: "Verification failed. Please try again.",
      invalid: "Please enter your name and a valid email address.",
    };
    const code = new URLSearchParams(location.search).get("error");
    if (code && messages[code]) {
      const el = document.getElementById("form-error");
      el.textContent = messages[code];
      el.hidden = false;
    }
  </script>
</Base>
