---
import { actions } from "astro:actions";
import ChoiceGroup from "../../components/form/ChoiceGroup.astro";
import Field from "../../components/form/Field.astro";
import Form from "../../components/form/Form.astro";
import { formErrors, submittedValues } from "../../components/form/state";
import { CONTACT_MAX, CONTACT_MESSAGES } from "../../forms/common";
import { VOLUNTEER_INTEREST_LABELS, VOLUNTEER_INTERESTS, VOLUNTEER_MAX } from "../../forms/volunteer";
import Base from "../../layouts/Base.astro";

export const prerender = false;

const result = Astro.getActionResult(actions.volunteer);
if (result && !result.error) return Astro.redirect("/volunteer/thanks/", 303);

const errors = formErrors(result?.error);
const values = await submittedValues(Astro, result?.error);
const value = (name: string) => values.get(name)?.toString();
const interests = VOLUNTEER_INTERESTS.map((v) => ({ value: v, label: VOLUNTEER_INTEREST_LABELS[v] }));
---

<Base title={errors ? "Error: Volunteer" : "Volunteer"} description="Volunteer with Operation In My Backyard at our weekly harm reduction outreach in Kensington, Philadelphia. No experience needed.">
  <h1>Volunteer</h1>
  <p>We're always looking for people who want to help, and you don't need any experience. Tell us a little about yourself below and we'll reach out.</p>

  <h2>What we need help with</h2>
  <ul>
    {interests.map((i) => <li>{i.label}</li>)}
  </ul>

  <Form action={actions.volunteer} submitLabel="Sign up" errors={errors}>
    <Field name="name" label="Name" autocomplete="name" maxlength={CONTACT_MAX.name} required requiredMessage={CONTACT_MESSAGES.name} value={value("name")} error={errors?.fields.name} />
    <Field name="email" label="Email" type="email" autocomplete="email" maxlength={CONTACT_MAX.email} required requiredMessage={CONTACT_MESSAGES.email} value={value("email")} error={errors?.fields.email} />
    <Field name="phone" label="Phone (optional)" type="tel" autocomplete="tel" maxlength={CONTACT_MAX.phone} value={value("phone")} error={errors?.fields.phone} />
    <ChoiceGroup name="interests" legend="How would you like to help?" type="checkbox" options={interests} checked={values.getAll("interests").map(String)} error={errors?.fields.interests} />
    <Field name="message" label="Message (optional)" type="textarea" maxlength={VOLUNTEER_MAX.message} value={value("message")} error={errors?.fields.message} />
  </Form>
</Base>
